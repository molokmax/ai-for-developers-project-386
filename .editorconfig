root = true

# Общие правила для всех файлов
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,jsonc,yml,yaml,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# C# / .NET
[*.cs]
indent_size = 4

# Упорядочивать using-директивы, System.* первыми
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# var: явно там, где тип непонятен из правой части
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Ключевые слова (int, string) вместо псевдонимов типов (Int32, String)
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# Тело в одну строку и выражения
csharp_prefer_braces = true:warning
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion

# Удаление неиспользуемых using
dotnet_diagnostic.IDE0005.severity = warning
# XML-документация включена только ради IDE0005 на билде,
# обязательные комментарии на всех публичных членах не нужны
dotnet_diagnostic.CS1591.severity = none

# Pattern matching вместо as/явных проверок null
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_prefer_simple_default_expression = true:suggestion
csharp_style_inferred_tuple_name = true:suggestion
csharp_style_prefer_null_check_over_null_check_pattern = true:suggestion

# Nullable warning для async-контекста в ASP.NET не включаем
dotnet_diagnostic.CA2007.severity = none

# .NET-анализаторы: sensible defaults

# EF Core: код миграций генерируется инструментом, style-правила к нему не применяем
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0005.severity = none
# severity у style-правил важнее dotnet_diagnostic.IDE0161, поэтому переопределяем само правило
csharp_style_namespace_declarations = block_scoped:silent

# Тесты: имена методов через подчёркивание (Method_Condition_Expectation) -
# общепринятая конвенция, CA1707 здесь мешает
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
