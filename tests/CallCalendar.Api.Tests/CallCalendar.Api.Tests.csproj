<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CallCalendar.Api\CallCalendar.Api.csproj" />
  </ItemGroup>

  <!--
    MinimalOpenAPI копирует OpenApi-айтемы в выходной каталог только проекта, объявившего их.
    Для WebApplicationFactory схема нужна в bin тестового проекта: копируем с той же формулой
    SchemaId (стабильный хэш полного пути файла), что и targets пакета в API-проекте.
  -->
  <ItemGroup>
    <_ContractSchema Include="..\..\contracts\generated\openapi.json">
      <SchemaId>$([System.Math]::Abs($([MSBuild]::StableStringHash('%(FullPath)'))))</SchemaId>
    </_ContractSchema>
  </ItemGroup>
  <Target Name="CopyContractSchemaToTestOutput" AfterTargets="Build">
    <MakeDir Directories="@(_ContractSchema->'$(OutDir)openapi/schemas/%(SchemaId)')" />
    <Copy SourceFiles="@(_ContractSchema)"
          DestinationFiles="@(_ContractSchema->'$(OutDir)openapi/schemas/%(SchemaId)/%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>