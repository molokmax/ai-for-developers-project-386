# Параметры SSH-подключения к VPS для scripts/deploy.sh.
# Скопируй этот файл в .env.deploy (не коммитится, в .gitignore) и заполни.

# IP или домен VPS
DEPLOY_HOST=203.0.113.10
# Порт SSH (по умолчанию 22)
DEPLOY_PORT=22
# Пользователь на VPS (должен иметь право запускать docker)
DEPLOY_USER=deploy
# Путь к приватному SSH-ключу. Пусто - берётся ключ по умолчанию из ~/.ssh
DEPLOY_SSH_KEY=~/.ssh/id_ed25519_vps
