<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Для инспекции генерата; файлы пишутся в obj/generated (в gitignore) -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- Сгенерированному дереву нечего доксумментировать: CS1591 (проекту GenerateDocumentationFile нужен ради IDE0005) -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="MinimalOpenAPI" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Контракт: contracts/main.tsp -> contracts/generated/openapi.json (npm run generate из contracts/) -->
    <OpenApi Include="..\..\contracts\generated\openapi.json"
             Namespace="Contracts"
             PublishAs="/openapi/schema.json" />
  </ItemGroup>

</Project>
